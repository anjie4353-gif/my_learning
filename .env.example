# MongoDB connection
MONGO_URL=mongodb://localhost:27017
DB_NAME=unmart_ecommerce

# Public base URL (no trailing slash) — used for generating product share URLs
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# CORS
CORS_ORIGINS=*

# JWT secrets — generate long random strings (>= 64 chars) for production
JWT_SECRET=replace-with-long-random-string-at-least-64-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-string-at-least-64-chars

# Admin (auto-seeded on first request to /api/init or /api/auth/login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@123

# WhatsApp store owner number (with country code, no '+', no spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Branding
NEXT_PUBLIC_STORE_NAME=UN Mart
NEXT_PUBLIC_STORE_TAGLINE=Handmade art with a touch of heart
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
